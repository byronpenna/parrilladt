# Copia este archivo a .env.local para desarrollo local.
# El route handler /api/graphql invoca el Lambda directo via AWS SDK
# (no hay API Gateway ni Function URL publicos), asi que necesita
# credenciales AWS validas con permiso lambda:InvokeFunction sobre
# pedidos-cancha-graphql (ver db/iam-policy-pedidos-cancha.json).

AWS_PROFILE=aula
GRAPHQL_LAMBDA_NAME=pedidos-cancha-graphql
GRAPHQL_LAMBDA_REGION=us-east-1

# Login (Cognito). InitiateAuth (USER_PASSWORD_AUTH) no requiere credenciales
# AWS - solo el ClientId - asi que no hace falta agregar nada a
# db/iam-policy-pedidos-cancha.json para que esto funcione en local.
COGNITO_USER_POOL_ID=us-east-1_p6H17oJch
COGNITO_CLIENT_ID=2ffs42rvd5h6ij33l3c4osib95
COGNITO_REGION=us-east-1

# Mapa de ubicacion de entrega (Google Maps JavaScript API + Places API).
# Esta key SI es publica por diseno (se incluye en el bundle del navegador):
# restringela en Google Cloud Console por referer HTTP a los dominios donde
# corre la app (localhost, el dominio de Amplify), nunca por secreto.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

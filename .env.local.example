# Copia este archivo a .env.local para desarrollo local.
# El route handler /api/graphql invoca el Lambda directo via AWS SDK
# (no hay API Gateway ni Function URL publicos), asi que necesita
# credenciales AWS validas con permiso lambda:InvokeFunction sobre
# pedidos-cancha-graphql (ver db/iam-policy-pedidos-cancha.json).

AWS_PROFILE=aula
GRAPHQL_LAMBDA_NAME=pedidos-cancha-graphql
GRAPHQL_LAMBDA_REGION=us-east-1

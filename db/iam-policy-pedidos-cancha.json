{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeCdkBootstrapRolesForDeploy",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::861418247819:role/cdk-hnb659fds-deploy-role-861418247819-us-east-1",
        "arn:aws:iam::861418247819:role/cdk-hnb659fds-file-publishing-role-861418247819-us-east-1",
        "arn:aws:iam::861418247819:role/cdk-hnb659fds-lookup-role-861418247819-us-east-1"
      ]
    },
    {
      "Sid": "ReadOwnStackStatus",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:GetTemplate"
      ],
      "Resource": "arn:aws:cloudformation:us-east-1:861418247819:stack/PedidosCancha*/*"
    },
    {
      "Sid": "InvokeMigrationLambda",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:861418247819:function:pedidos-cancha-migrate"
    },
    {
      "Sid": "InvokeGraphqlLambda",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:861418247819:function:pedidos-cancha-graphql"
    },
    {
      "Sid": "ReadRdsForPlanning",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances",
        "rds:DescribeDBSubnetGroups",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSsmCommandResults",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConfigureVpnBastionViaSsm",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:us-east-1:861418247819:instance/i-00ec2785a2eab1bc9",
        "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
      ]
    }
  ]
}
